# Copy to .env. Never commit a real credential.
# Memory commands and offline tests work with this key left blank.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Blank values use the repository database, resolved-project-path identity,
# and current OS username. Set stable identifiers only when intentionally sharing scope.
MEMORY_DB_PATH=
MEMORY_PROJECT_ID=
MEMORY_USER_ID=
MEMORY_HISTORY_TOKENS=6000
MEMORY_CONTEXT_TOKENS=1800
AGENT_MAX_ROUNDS=12

# Explicit opt-in only. An embedding model sends eligible memories/queries to
# OpenRouter and may incur charges. Leave blank for local SQLite/FTS5 retrieval.
MEMORY_EMBEDDING_MODEL=

# Required only when the coder invokes filesystem or terminal tools.
MINIKUBE_PROFILE=minikube
SANDBOX_NAMESPACE=agent-sandbox
SANDBOX_IMAGE=python:3.12-slim
