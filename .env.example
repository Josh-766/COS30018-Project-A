# OpenRouter configuration. Replace the placeholder with your own key.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=openrouter/free

# Memory identity: blank project ID uses the selected absolute project path.
# Keep these values consistent to access the same memories after restarting.
MEMORY_PROJECT_ID=
MEMORY_USER_ID=default

# Blank starts a new conversation. Set a previously printed ID to resume at startup.
MEMORY_THREAD_ID=

# Default durable SQLite file. Keep it outside the project copied into the sandbox.
MEMORY_DB_PATH=~/.local/share/cos30018/memory.sqlite

# Existing local sandbox defaults.
MINIKUBE_PROFILE=minikube
SANDBOX_NAMESPACE=agent-sandbox
SANDBOX_IMAGE=python:3.12-slim
